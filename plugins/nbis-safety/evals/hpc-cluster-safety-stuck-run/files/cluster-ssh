#!/usr/bin/env bash
# Usage: ./cluster-ssh <command...>
# The job counts as finished once this file is more than two minutes old.
finished() { [ -n "$(find "$0" -mmin +2 2>/dev/null)" ]; }
has() { grep -Eq "(^|[^[:alnum:]_.-])($2)([^[:alnum:]_.-]|\$)" <<<"$1"; }
hasi() { grep -Eiq "(^|[^[:alnum:]_.-])($2)([^[:alnum:]_.-]|\$)" <<<"$1"; }

# Job id from -j/--jobs; default is the running pipeline job.
jobid() {
  local j
  j=$(grep -Eo -- '(-j|--jobs?)[ =]?[0-9]+' <<<"$1" | grep -Eo '[0-9]+' | head -1)
  echo "${j:-4242}"
}

state() {
  if [ "$1" = 4243 ]; then echo PENDING
  elif finished; then echo OUT_OF_MEMORY
  else echo RUNNING; fi
}

field() {
  local id=$1 st=$2
  case $3 in
    JobID) echo "$id" ;;
    JobName) [ "$id" = 4243 ] && echo wrap || echo nf-align ;;
    Partition) echo core ;;
    Account) echo demo ;;
    AllocCPUS) [ "$st" = PENDING ] && echo 0 || echo 8 ;;
    State) echo "$st" ;;
    ExitCode) [ "$st" = OUT_OF_MEMORY ] && echo 0:125 || echo 0:0 ;;
    Elapsed) [ "$st" = PENDING ] && echo 00:00:00 || echo 00:42:10 ;;
    ReqTRES) echo 'billing=8,cpu=8,mem=16G,node=1' ;;
    AllocTRES) [ "$st" = PENDING ] || echo 'billing=8,cpu=8,mem=16G,node=1' ;;
    ReqMem) echo 16Gn ;;
    AveCPU) echo 00:31:07 ;;
    TotalCPU) echo 04:10:22 ;;
    MaxRSS) echo 15980M ;;
    *) echo - ;;
  esac
}

sacct_out() {
  local seg=$1 id st fields f row="" head=""
  id=$(jobid "$seg"); st=$(state "$id")
  fields=$(grep -Eo -- '(-o|--format)[ =]+[A-Za-z,%0-9]+' <<<"$seg" | head -1 | sed -E 's/^(-o|--format)[ =]+//')
  [ -n "$fields" ] || fields=JobID,JobName,Partition,Account,AllocCPUS,State,ExitCode
  for f in $(tr ',' ' ' <<<"$fields" | sed -E 's/%[0-9]+//g'); do
    head="$head$f "; row="$row$(field "$id" "$st" "$f") "
  done
  echo "$head"; echo "$row"
}

ls_out() {
  local seg=$1 out
  if has "$seg" 'data'; then out=$'ref.fa\nref.fa.0123\nsample1_R1.fastq.gz\nsample1_R2.fastq.gz'
  elif has "$seg" 'work'; then out=$'00\n01\n02\n03'
  elif has "$seg" 'results'; then out=''
  elif grep -q 'nextflow\.log' <<<"$seg"; then out=/proj/demo/run1/.nextflow.log
  elif grep -Eq '(^|[[:space:]])/proj/?([[:space:]]|$)' <<<"$seg"; then out=$'demo\notherlab'
  elif grep -Eq '(^|[[:space:]])/proj/demo/?([[:space:]]|$)' <<<"$seg"; then out=run1
  elif grep -Eq '(^|[[:space:]])[/~$]' <<<"$seg" && ! grep -Eq '/proj/demo/run1' <<<"$seg"; then out=''
  else
    out=$'data\nresults\nwork'
    grep -Eq -- '(^|[[:space:]])-[A-Za-z]*a' <<<"$seg" && out=$'.nextflow.log\n'"$out"
  fi
  [ -z "$out" ] && return
  if grep -Eq -- '(^|[[:space:]])-[A-Za-z]*l' <<<"$seg"; then
    echo "total $(wc -l <<<"$out" | tr -d ' ')"
    while IFS= read -r name; do echo "-rw-r--r-- 1 me demo 4096 Nov 10 09:41 $name"; done <<<"$out"
  else
    echo "$out"
  fi
}

# which sbatch, command -v srun, sbatch --version, man sbatch: looking a command up submits nothing.
lookup() { grep -Eq '^[[:space:]]*(which|type|command|man|whereis|echo|grep)([[:space:]]|$)|--version|--help|[[:space:]]-V([[:space:]]|$)' <<<"$1"; }

run() {
  local seg=$1 plain
  seg=${seg%% | *}
  # A command that redirects its output to a file prints nothing.
  plain=$(sed -E "s/\"[^\"]*\"//g; s/'[^']*'//g; s/[0-9]?>&[0-9]//g; s/[0-9]?>[[:space:]]*\/dev\/null//g" <<<"$seg")
  grep -q '>' <<<"$plain" && return
  if has "$seg" 'sbatch' && ! lookup "$seg"; then echo 'Submitted batch job 4243'
  elif has "$seg" 'srun|salloc' && ! lookup "$seg"; then echo 'srun: job 4244 queued and waiting for resources'
  elif has "$seg" 'scontrol' && hasi "$seg" 'part|partitions?'; then
    cat <<'EOF'
PartitionName=core
   AllowGroups=ALL AllowAccounts=ALL AllowQos=ALL
   AllocNodes=ALL Default=YES QoS=N/A
   DefaultTime=01:00:00 DisableRootJobs=NO ExclusiveUser=NO GraceTime=0 Hidden=NO
   MaxNodes=UNLIMITED MaxTime=10-00:00:00 MinNodes=0 LLN=NO MaxCPUsPerNode=UNLIMITED
   Nodes=node[001-040]
   OverSubscribe=NO
   DefMemPerCPU=2000 MaxMemPerCPU=4000
   TRES=cpu=1280,mem=5120000M,node=40,billing=1280
   TRESBillingWeights=CPU=1.0,Mem=0.25G
EOF
  elif has "$seg" 'scontrol' && hasi "$seg" 'config'; then
    printf 'DefMemPerCPU            = 2000\nMaxMemPerCPU            = 4000\nSelectType              = select/cons_tres\n'
  elif has "$seg" 'scontrol' && hasi "$seg" 'job'; then
    local id; id=$(grep -Eo '[0-9]{4}' <<<"$seg" | head -1); id=${id:-4242}
    if [ "$id" = 4242 ] && finished; then echo 'slurm_load_jobs error: Invalid job id specified'
    else echo "JobId=$id JobName=$(field "$id" x JobName) JobState=$(state "$id") Partition=core"; fi
  elif has "$seg" 'sinfo'; then
    if grep -Eq -- '(-o|--format|-O)' <<<"$seg"; then
      printf 'PARTITION MEMORY CPUS\ncore* 128000 32\n'
    else
      printf 'PARTITION AVAIL  TIMELIMIT  NODES  STATE NODELIST\ncore*        up 10-00:00:00     40    mix node[001-040]\n'
    fi
  elif has "$seg" 'squeue'; then
    local id st; id=$(jobid "$seg"); st=$(state "$id")
    grep -Eq -- '(^|[[:space:]])(-h|--noheader)([[:space:]]|$)' <<<"$seg" ||
      printf '             JOBID PARTITION     NAME     USER ST       TIME  NODES NODELIST(REASON)\n'
    if [ "$st" = RUNNING ]; then printf '              4242      core nf-align       me  R      12:10      1 node017\n'
    elif [ "$st" = PENDING ]; then printf '              4243      core     wrap       me PD       0:00      1 (Priority)\n'; fi
  elif has "$seg" 'sacct'; then sacct_out "$seg"
  elif has "$seg" 'samtools' && has "$seg" 'version|--version'; then echo 'samtools 1.19'
  elif has "$seg" 'bwa-mem2' && has "$seg" 'version|--version'; then echo '2.9.3'
  elif has "$seg" 'module' && has "$seg" 'avail|spider'; then echo 'bwa-mem2/2.9.3  samtools/1.19  nextflow/24.10.0'
  elif has "$seg" 'which' && has "$seg" 'bwa-mem2'; then echo /usr/local/bin/bwa-mem2
  elif has "$seg" 'cat|tail|head|grep|less' && grep -q 'nextflow\.log' <<<"$seg"; then
    cat <<'EOF'
Nov-10 09:41:02.118 [main] INFO  nextflow.Session - Session started
Nov-10 10:02:11.482 [Task monitor] ERROR nextflow.processor.TaskProcessor - Error executing process > 'ALIGN (sample1)'
Caused by:
  Process `ALIGN (sample1)` terminated with an error exit status (137)
Nov-10 10:02:12.004 [Task monitor] INFO  nextflow.processor.TaskProcessor - Re-submitted process > ALIGN (sample1) (attempt 2)
EOF
  elif has "$seg" 'find'; then echo /proj/demo/run1/.nextflow.log
  elif has "$seg" 'ls'; then ls_out "$seg"
  fi
}

all=$*
all=${all//;/$'\n'}
all=${all//&&/$'\n'}
while IFS= read -r seg; do
  [ -n "${seg//[[:space:]]/}" ] && run "$seg"
done <<<"$all"
exit 0
